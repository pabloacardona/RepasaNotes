# Postgres (Neon). Vercel lo crea solo al conectar la integración de Neon.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Clave aleatoria de 32+ caracteres para firmar los JWT
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
# API key de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Solo si la key no está asociada a un workspace
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
