# Postgres (Neon). Vercel lo crea solo al conectar la integración de Neon.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Clave aleatoria de 32+ caracteres para firmar los JWT
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Proveedor de IA: "gateway" (Vercel AI Gateway, por defecto) o "anthropic" (Claude directo)
AI_PROVIDER=gateway
# gateway: opcional fuera de Vercel (en Vercel se usa OIDC automáticamente)
AI_GATEWAY_API_KEY=
# anthropic: clave de console.anthropic.com (necesita créditos de API) y modelo opcional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
